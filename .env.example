# Server & Database Configuration
DATABASE_URL=sqlite:///./rail_nirdeshak.db
SECRET_KEY=your_jwt_secret_key_minimum_32_characters
PORT=8000
HOST=0.0.0.0

# Initial Controller / Administrator Credentials
ADMIN_USERNAME=controller
ADMIN_EMAIL=control@railnirdeshak.in
ADMIN_PASSWORD=ChangeMeAdmin2026!
ADMIN_NAME=Northern Zone Traffic Controller

# External Mapping & Weather APIs (Optional)
MAPTILER_API_KEY=your_maptiler_api_key_here
MAP_API_KEY=your_map_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# Firebase Phone OTP & Admin SDK Configuration
# Public Web App Config (Exposed via /api/config for browser Firebase Auth client)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_API_KEY=your_firebase_web_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_web_app_id

# Backend Firebase Admin SDK Private Credentials (Keep Secret!)
# Option A: Path to service account JSON key file downloaded from Firebase Console
# FIREBASE_SERVICE_ACCOUNT_KEY=/etc/secrets/firebase-service-account.json
# Option B: Inline JSON string of service account key (useful for cloud deployments like Render/Fly.io)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "...", ...}
# Option C: Standard Google Cloud Application Credentials path
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json
